executor {
    name = 'local'
    cpus = 16
    memory = '60 GB'
    queueSize = 2
}
params {
    star_limit_bam_sort_ram = 55000000000
}
process {
    maxForks = 2
    withName: 'RNAFUSION:FASTQ_ALIGN_STAR:STAR_ALIGN' {
        cpus = 12
        memory = 60.GB
    }
    withName: 'RNAFUSION:STARFUSION_DETECT' {
        cpus = 12
        memory = 60.GB
    }
}
